{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencode-staging-debug-mcp-v2",
  "main": "src/staging-control-mcp.js",
  "compatibility_date": "2026-06-11",
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "STAGING_AGENT",
        "class_name": "OpenCodeAgent",
        "script_name": "opencode-g1-staging"
      }
    ]
  }
}
