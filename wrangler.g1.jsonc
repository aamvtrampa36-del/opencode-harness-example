{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencode-g1-staging",
  "preview_urls": false,
  // Staging entrypoint: the production Worker (src/server.ts) re-exported
  // unchanged plus the disposable B2 drill class. wrangler.jsonc (production)
  // keeps main: "src/server.ts" and is untouched.
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/api/health",
      "/api/dev/*",
      "/api/session/*",
      "/api/settings/*",
      "/api/settings",
      "/api/supervisor/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OpenCodeAgent",
        "class_name": "OpenCodeAgent"
      },
      {
        "name": "DEV",
        "class_name": "DevContainer"
      },
      {
        "name": "SETTINGS",
        "class_name": "PersonalSettings"
      },
      {
        "name": "SESSION_BK",
        "class_name": "SessionBackupDrillAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OpenCodeAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DevContainer"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "PersonalSettings"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "SessionBackupDrillAgent"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "DevContainer",
      "scheduling_policy": "durable_object"
    }
  ],
  // Staging-only private R2 bucket for the external backup drill (pendiente B).
  // Never declared in wrangler.jsonc; no token or ACL change is required.
  "r2_buckets": [
    {
      "binding": "RECOVERY_R2",
      "bucket_name": "opencode-v1-recovery-20261112"
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "G1_DEV_UNLIMITED_CHECKS": "true",
    "OPENCODE_SUPERVISOR_ENABLED": "true"
  },
  "workflows": [
    {
      "name": "opencode-supervisor-stage",
      "binding": "SUPERVISOR_WORKFLOW",
      "class_name": "OpenCodeSupervisorWorkflow"
    }
  ]
}
