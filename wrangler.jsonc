{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opencode-harness-example",
  "preview_urls": false,
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat",
    "durable_object_io_tasks_prevent_eviction"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/api/health",
      "/api/dev/*",
      "/api/session/*",
      "/api/settings/*",
      "/api/settings",
      "/api/supervisor/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OpenCodeAgent",
        "class_name": "OpenCodeAgent"
      },
      {
        "name": "DEV",
        "class_name": "DevContainer"
      },
      {
        "name": "SETTINGS",
        "class_name": "PersonalSettings"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OpenCodeAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DevContainer"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "PersonalSettings"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "placement": { "mode": "smart" },
  // Keep dynamic, authenticated and MCP responses out of shared Workers Cache.
  // Workers Static Assets remain independently cached by Cloudflare.
  "cache": { "enabled": false, "cross_version_cache": false },
  "containers": [
    {
      "class_name": "DevContainer",
      "scheduling_policy": "durable_object"
    }
  ],
  "vars": {
    "OPENCODE_SUPERVISOR_ENABLED": "false"
  }
}
